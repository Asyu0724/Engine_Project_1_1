--- !u!114 &1162849510
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1162849508}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61abd5c262e86d458c9e086d8440b3b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogManager
  dialoguePanel: {fileID: 1162849508}
  nameText: {fileID: 1627997074}
  dialogueText: {fileID: 928123974}
  leftCharacter: {fileID: 557686637}
  rightCharacter: {fileID: 1661967564}
  nextTextAudio: {fileID: 622283225}
  activeScale: 1.1
  dimColor: {r: 0.4, g: 0.4, b: 0.4, a: 1}
  typingSpeed: 0.05
  dialogues:
  - speakerPosition: 0
    speakerName: "\uC720\uD0A4"
    dialogueText: "\uB4DC\uB514\uC5B4 \uCC3E\uC558\uB124, \uAC00\uC9DC\uB099\uC6D0\uC758
      \uC8FC\uC778. "
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
    emotionAnimation: 0
  - speakerPosition: 1
    speakerName: ???
    dialogueText: "\uC624~ \uCD95\uD558\uD574 \uC720\uD0A4~ \uB4DC\uB514\uC5B4 \uC654\uB124?"
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
    emotionAnimation: 2
  - speakerPosition: 0
    speakerName: "\uC720\uD0A4"
    dialogueText: "\uC0AC\uB78C\uB4E4\uC744 \uB05D\uC5C6\uB294 \uC218\uB9C8\uC5D0
      \uBE60\uB728\uB9B0 \uAC8C \uB108\uC9C0?"
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
    emotionAnimation: 0
  - speakerPosition: 0
    speakerName: "\uC720\uD0A4"
    dialogueText: "\uD589\uBCF5\uD55C \uC545\uBABD\uC774\uB77C\uB2C8, \uCDE8\uBBF8
      \uD55C\uBC88 \uACE0\uC57D\uD558\uB124."
    leftSprite: {fileID: -1029619751330361890, guid: 14ddb8daa57d8614a932d97a586d2b9e, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 0
  - speakerPosition: 0
    speakerName: "\uC720\uD0A4"
    dialogueText: "\uC5D0\uB9AC, \uC0AC\uB78C\uB4E4\uC744 \uADF8\uB807\uAC8C \uB9CC\uB4E4\uC5B4
      \uB193\uACE0\uC120,"
    leftSprite: {fileID: -7869612727017600986, guid: b811b99ce92791142ba46961ea787da2, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 0
  - speakerPosition: 0
    speakerName: "\uC720\uD0A4"
    dialogueText: "\uC77C\uB9D0\uC758 \uC8C4\uCC45\uAC10\uB3C4 \uC5C6\uB294 \uAC70\uC57C?"
    leftSprite: {fileID: -1029619751330361890, guid: 14ddb8daa57d8614a932d97a586d2b9e, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 1
  - speakerPosition: 1
    speakerName: "\uC5D0\uB9AC"
    dialogueText: "\uC545\uBABD\uC774\uB77C\uB2C8 \uB108\uBB34\uD574!\u3160"
    leftSprite: {fileID: -1029619751330361890, guid: 14ddb8daa57d8614a932d97a586d2b9e, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 3
  - speakerPosition: 1
    speakerName: "\uC5D0\uB9AC"
    dialogueText: "\uB09C \uBAA8\uB450\uC5D0\uAC8C \uD3C9\uC628\uD55C \uC548\uC2DD\uC744
      \uC120\uBB3C\uD55C \uAC83\uBFD0\uC778\uB370...\u3160"
    leftSprite: {fileID: -1029619751330361890, guid: 14ddb8daa57d8614a932d97a586d2b9e, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 0
  - speakerPosition: 0
    speakerName: "\uC720\uD0A4"
    dialogueText: "\uC601\uC6D0\uD788 \uAE68\uC5B4\uB0A0 \uC218 \uC5C6\uB294 \uC548\uC2DD\uC740
      \uC8FD\uC74C\uACFC \uB2E4\uB97C \uBC14 \uC5C6\uC5B4."
    leftSprite: {fileID: -7869612727017600986, guid: b811b99ce92791142ba46961ea787da2, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 0
  - speakerPosition: 0
    speakerName: "\uC720\uD0A4"
    dialogueText: "\uB2F9\uC7A5 \uADF8\uB9CC\uB46C."
    leftSprite: {fileID: -1029619751330361890, guid: 14ddb8daa57d8614a932d97a586d2b9e, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 1
  - speakerPosition: 1
    speakerName: "\uC5D0\uB9AC"
    dialogueText: "\uC5EC\uAE30\uAE4C\uC9C0 \uC628\uAC70,"
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
    emotionAnimation: 0
  - speakerPosition: 1
    speakerName: "\uC5D0\uB9AC"
    dialogueText: "\uB108\uB3C4 \uC880 \uC26C\uB2E4\uAC00\uB294 \uAC70 \uC5B4\uB54C?"
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
    emotionAnimation: 2
  - speakerPosition: 0
    speakerName: "\uC720\uD0A4"
    dialogueText: ...
    leftSprite: {fileID: -7869612727017600986, guid: b811b99ce92791142ba46961ea787da2, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 0
  - speakerPosition: 0
    speakerName: "\uC720\uD0A4"
    dialogueText: "\uC808\uB300 \uB2C8 \uC0DD\uAC01\uB300\uB85C \uB418\uC9C0 \uC54A\uC744\uAC70\uC57C."
    leftSprite: {fileID: -1029619751330361890, guid: 14ddb8daa57d8614a932d97a586d2b9e, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 1
  - speakerPosition: 1
    speakerName: "\uC5D0\uB9AC"
    dialogueText: ...
    leftSprite: {fileID: -1029619751330361890, guid: 14ddb8daa57d8614a932d97a586d2b9e, type: 3}
    rightSprite: {fileID: 0}
    emotionAnimation: 0
  - speakerPosition: 1
    speakerName: "\uC5D0\uB9AC"
    dialogueText: "\uB9C9\uC744 \uC218 \uC788\uB2E4\uBA74 \uB9C9\uC544\uBD10."
    leftSprite: {fileID: -1029619751330361890, guid: 14ddb8daa57d8614a932d97a586d2b9e, type: 3}
    rightSprite: {fileID: -3012566654067343012, guid: 6dd7b773f6d68aa45923a51301f750d3, type: 3}
    emotionAnimation: 1
  - speakerPosition: 1
    speakerName: "\uC5D0\uB9AC"
    dialogueText: "\uACB0\uAD6D \uC774\uAE30\uB294 \uAC74 \uB098\uB2C8\uAE4C."
    leftSprite: {fileID: -1029619751330361890, guid: 14ddb8daa57d8614a932d97a586d2b9e, type: 3}
    rightSprite: {fileID: -3012566654067343012, guid: 6dd7b773f6d68aa45923a51301f750d3, type: 3}
    emotionAnimation: 0
